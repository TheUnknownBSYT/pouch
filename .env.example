# Existing Supabase project. Only the public/anon key belongs in a client build.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Enable only after the signed WhatsApp receiver has been deployed and tested.
# International format, digits only; this is the Pouch business number.
EXPO_PUBLIC_WHATSAPP_NUMBER=

# Real HTTPS download/store page used in user-initiated invite shares.
EXPO_PUBLIC_INSTALL_URL=
